# Resend — used to send a single notification email whenever a new
# demo submission is created. See lib/demoNotification.ts.
# Get an API key at https://resend.com after verifying your sending domain.
RESEND_API_KEY=

# Verified sender address, e.g. "Nothing Records <notifications@nothingrecords.site>"
EMAIL_FROM=

# Where the "new demo submitted" notification email should be delivered
DEMO_NOTIFICATION_EMAIL=demo@nothingrecords.site

# Link included in the notification email, pointing at the admin inbox
ADMIN_URL=https://nothingrecords.site/admin
