# Use the URL and keys of the existing Supabase project.
SUPABASE_URL=https://YOUR_EXISTING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server only. Needed for private artwork upload and verification.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Public landing page origin. In production: https://uwbelieve.com
SITE_URL=http://localhost:3000
# Optional: point both subdomains to the same Next.js deployment.
# Hostnames only, without scheme or paths.
ARTIST_HOSTNAME=artists.uwbelieve.com
ADMIN_HOSTNAME=label.uwbelieve.com

# Optional notification email for landing page demos.
RESEND_API_KEY=
EMAIL_FROM=uwbelieve <hello@your-label.com>
DEMO_NOTIFICATION_EMAIL=
ADMIN_URL=https://label.uwbelieve.com/admin/demos
